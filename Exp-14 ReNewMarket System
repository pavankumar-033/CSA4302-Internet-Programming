<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ReNewMarket | Second Hand Marketplace</title>

<link rel="stylesheet" href="style.css">

</head>

<body>

<!-- Header -->

<header>

<div class="logo">
♻️ ReNewMarket
</div>

<nav>

<ul>

<li><a href="#home">Home</a></li>
<li><a href="#categories">Categories</a></li>
<li><a href="#products">Products</a></li>
<li><a href="#sell">Sell Item</a></li>
<li><a href="#contact">Contact</a></li>

</ul>

</nav>

</header>

<!-- Hero -->

<section class="hero" id="home">

<div class="hero-content">

<h1>Buy & Sell Pre-Loved Items</h1>

<p>
Best Marketplace for Second-Hand Products
</p>

<a href="#products" class="btn">
Explore Products
</a>

</div>

</section>

<!-- Login -->

<section class="login">

<h2>User Login</h2>

<form>

<input
type="email"
placeholder="Email Address">

<input
type="password"
placeholder="Password">

<button type="button">
Login
</button>

<p>

New User?

<a href="#">Register Here</a>

</p>

</form>

</section>

<!-- Categories -->

<section
class="categories"
id="categories">

<h2>Categories</h2>

<div class="category-box">

<div class="category">
📱
<h3>Electronics</h3>
</div>

<div class="category">
🛋️
<h3>Furniture</h3>
</div>

<div class="category">
👕
<h3>Clothing</h3>
</div>

<div class="category">
🎁
<h3>Collectibles</h3>
</div>

</div>

</section>

<!-- Products -->

<section
class="products"
id="products">

<h2>Latest Products</h2>

<div class="product-container">

<div class="card">

<img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=600">

<h3>Used iPhone 13</h3>

<p>Excellent Condition</p>

<p class="price">

₹42,000

</p>

<button onclick="product('iPhone 13')">

View Details

</button>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=600">

<h3>Wooden Sofa</h3>

<p>Premium Quality</p>

<p class="price">

₹15,000

</p>

<button onclick="product('Wooden Sofa')">

View Details

</button>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=600">

<h3>Branded Jacket</h3>

<p>Like New</p>

<p class="price">

₹1,200

</p>

<button onclick="product('Branded Jacket')">

View Details

</button>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?w=600">

<h3>Gaming Laptop</h3>

<p>16GB RAM | SSD</p>

<p class="price">

₹48,000

</p>

<button onclick="product('Gaming Laptop')">

View Details

</button>

</div>

</div>

</section>

<!-- Sell -->

<section
class="sell"
id="sell">

<h2>Sell Your Product</h2>

<form>

<input
type="text"
placeholder="Product Name">

<input
type="number"
placeholder="Price">

<select>

<option>Category</option>

<option>Electronics</option>

<option>Furniture</option>

<option>Clothing</option>

<option>Collectibles</option>

</select>

<textarea
placeholder="Product Description"></textarea>

<button>

Submit Listing

</button>

</form>

</section>

<!-- Contact -->

<section
class="contact"
id="contact">

<h2>Contact Us</h2>

<form>

<input
type="text"
placeholder="Your Name">

<input
type="email"
placeholder="Email">

<textarea
placeholder="Message"></textarea>

<button>

Send Message

</button>

</form>

</section>

<footer>

<p>

© 2026 ReNewMarket | Buy • Sell • Reuse

</p>

</footer>

<script src="script.js"></script>

</body>
</html>
